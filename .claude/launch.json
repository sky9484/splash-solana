{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "splash-solana-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3000"
      ],
      "port": 3000,
      "autoPort": false,
      "env": {
        "TEMP": "D:\\splash-solana\\.tmp",
        "TMP": "D:\\splash-solana\\.tmp",
        "TMPDIR": "D:\\splash-solana\\.tmp",
        "NEXT_TELEMETRY_DISABLED": "1",
        "NODE_OPTIONS": "--use-system-ca"
      }
    }
  ]
}
