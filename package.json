    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@scure/bip39": "^2.4.0",
    "@solana/web3.js": "^1.99.0",
    "@sqds/multisig": "^2.1.4",
    "@tanstack/react-query": "^5.100.9",
    "@types/qrcode": "^1.5.6",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.14.0",
    "next": "16.3.6",
    "papaparse": "^5.5.3",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "react-to-print": "^3.3.0",
    "read-excel-file": "^9.3.10",
    "sas-lib": "^1.0.10",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
