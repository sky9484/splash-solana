    "test:solana": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/alias-hook.mjs --test tests/solana-*.test.mjs",
    "test:binary": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/no-binary-source.test.mjs",
    "test:model": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/alias-hook.mjs --test tests/copilot-model.test.mjs",
    "test:copilotscope": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/copilot-scope.test.mjs",
    "test:oxwal": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/alias-hook.mjs --test tests/oxwal-state-machine.test.mjs tests/oxwal-agent.test.mjs tests/oxwal-policy.test.mjs tests/oxwal-approval-queue.test.mjs tests/oxwal-evidence.test.mjs tests/oxwal-safety.test.mjs tests/oxwal-frontend.test.mjs tests/oxwal-e2e.test.mjs tests/oxwal-authority.test.mjs tests/comparison-baselines.test.mjs tests/money-path.test.mjs tests/payout-authorization.test.mjs tests/settlement-minimum.test.mjs tests/receipt-share.test.mjs tests/phase0-custody-gate.test.mjs tests/landing-and-numbers.test.mjs",
