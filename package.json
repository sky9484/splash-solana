    "db:migrate": "drizzle-kit migrate",
    "db:migrate:run": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate.mjs",
    "seed:demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/alias-hook.mjs scripts/seed-demo-user.mjs",
