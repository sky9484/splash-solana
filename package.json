{
  "name": "splash-finance",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.11 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--use-system-ca next dev",
    "dev:db": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/alias-hook.mjs scripts/dev-db.mjs",
    "build": "next build",
    "doctor": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/doctor.mjs",
    "start": "cross-env NODE_OPTIONS=--use-system-ca next start",
    "lint": "npm run check:copy && npm run check:numbers && npm run check:migrations && npm run check:stores && npm run check:binary && npm run check:env && eslint",
    "check:copy": "node scripts/check-copy.mjs",
    "check:binary": "node scripts/check-no-binary-source.mjs",
    "check:stores": "node scripts/check-store-access.mjs",
    "check:migrations": "node scripts/check-migration-journal.mjs",
    "check:env": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/check-env-reads.mjs",
    "test:auth": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/customer-session.test.mjs tests/wallet-onboarding.test.mjs tests/auth-fail-closed.test.mjs tests/device-key-authority.test.mjs tests/google-oidc.test.mjs tests/google-account-link.test.mjs tests/passkey-authority.test.mjs tests/membership-admin.test.mjs tests/account-verification.test.mjs",
