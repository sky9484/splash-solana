# ── Solana (lib/solana/config.ts) ─────────────────────────────────────
# offline (default) touches no network; devnet sends real devnet transactions.
SPLASH_SOLANA_MODE=offline
SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=
# Kora: Splash's fee payer, so nobody needs SOL. Required when SPLASH_SOLANA_MODE=devnet.
KORA_RPC_URL=
KORA_API_KEY=
# Splash's fee wallet on Solana (base58). Needed only when STABLECOIN_ANCHOR_FEE=on.
SPLASH_FEE_ADDRESS=

# Stablecoin lane (lib/payments/stablecoin-lane.ts). Transfers carry no Splash
# fee. Out of Splash (not to a Splash user's vault), the audit-anchor fee —
# 0.02%, min 0.05, max 5 USDC — applies only when this is `on`, and then needs
# SPLASH_FEE_ADDRESS. Off (blank) by default.
STABLECOIN_ANCHOR_FEE=
# Chainalysis free sanctions API (public.chainalysis.com). Blank: wallet
# recipients are saved unscreened and are paid only after an admin attests.
CHAINALYSIS_SANCTIONS_API_KEY=

# Labuan Settlement Engine (Splash Labuan Ltd — Labuan FSA Money Broker + DFS)
LABUAN_API_BASE_URL=https://settlement.splash-labuan.internal
LABUAN_API_KEY=
LABUAN_OTC_MIN_USD=10000

# FX Rates (MYR→USD via authorized dealer bank)
MYR_TO_USD_RATE=
FALLBACK_MYR_USD_RATE=0.213

# Intercompany Banking (Maybank KL → Maybank Labuan)
MAYBANK_INTERCOMPANY_ENABLED=true

PHP_PER_USDC=56.5

# Local-currency payouts: 0.70% of the amount, every corridor, nothing fixed
# (2026-09-26). Per-corridor fees live in lib/fx/corridors.ts (all 70 bps);
# this is the fallback only for a currency with no corridor.
PLATFORM_FEE_BPS=70
# A fixed fee per payout, in cents, on top of the percentage. None: 0.
FIXED_FEE_CENTS=0
QUOTE_TTL_SECONDS=30
DEFAULT_KYC_TIER=1
USDC_AVAILABLE_MICRO=1000000000000000
USE_MOCK_APIS=false
# Launch scope. Blank = full. `stablecoin` opens the USDC wallet lane only:
# fiat, payout runs and treasury answer 403, and production then boots with
# mocks off without PDAX, Walrus, Stripe or Airwallex (lib/launch-scope-rules.ts).
# It refuses mocks, demo mode, card funding and treasury execution.
LAUNCH_SCOPE=

# Phase 1 demo and delivery ladder
NEXT_PUBLIC_DEMO_MODE=false
STORED_BALANCE_CORRIDORS=
# false = SWEEP_ACCOUNT is never recommended or offered, and a sweep is refused before
# a recipient, transfer or ledger line is written. Read at startup like every env var:
# it takes effect on restart. Only matters once the custody phase is on.
SWEEP_ACCOUNT_ENABLED=true
TREASURY_EXECUTION_ENABLED=false
RATE_HOLD_HOURS=48

# Walrus publisher/aggregator. Mock round-trip is used when USE_MOCK_APIS=true.
WALRUS_PUBLISHER_URL=
WALRUS_AGGREGATOR_URL=

# Seal threshold encryption. The committee, threshold, package and policy are
# NOT environment variables: they live in config/seal.<env>.json, committed,
# one file per environment, so every machine reads the same list. See
# config/README.md. Setting SEAL_KEY_SERVER_ENDPOINTS, SEAL_THRESHOLD,
# SEAL_PACKAGE_ID, SEAL_POLICY_OBJECT_ID, SEAL_KEY_SERVER_MODE or
# SEAL_APPROVE_TARGET here fails boot by name. What stays in env is
# operational: the health-check timeout and the alert webhook.
SEAL_HEALTH_TIMEOUT_MS=10000
SEAL_ALERT_WEBHOOK_URL=

# PDAX payout adapter. Mock payout is used when USE_MOCK_APIS=true.
PDAX_API_BASE_URL=
PDAX_API_KEY=

SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_LEVEL_NAME=
SUMSUB_BASE_URL=https://api.sumsub.com

# Staff and workspace credentials. Blank on purpose: a value here is a
# working login for anyone who clones the repository. Set real ones in
# .env.local. lib/env.ts refuses to boot production without
# ADMIN_SESSION_SECRET, or with the demo password this file used to ship.
# In production, staff sign-in refuses every login unless ADMIN_EMAIL,
# ADMIN_PASSWORD and ADMIN_SESSION_SECRET are all set (lib/server/admin-auth.ts).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Business workspace session. Local development falls back to the demo account;
# production must configure these values and should leave self-signup disabled
# unless backed by a real customer provisioning flow.
# CUSTOMER_EMAIL / CUSTOMER_PASSWORD are GONE. There is no single
# deployment credential any more: accounts are rows in `users` with a
# scrypt hash, created through /api/auth/signup. Setting either here fails
# boot by name, because a password in a file that governs nothing still
# reads as a control.
CUSTOMER_ORGANIZATION=
CUSTOMER_SESSION_SECRET=
CUSTOMER_SELF_SIGNUP_ENABLED=false
CUSTOMER_RECOVERY_EMAIL=support@splash.finance

NEXT_PUBLIC_APP_URL=http://localhost:3000
# The domain every passkey is bound to (lib/auth/passkey.ts). Passkeys are a
# sign-in and step-up factor; changing the domain later means everyone creates
# a new one, so it is decided ONCE, before anyone creates a real passkey. Production: splashz.xyz (the root
# domain), so passkeys work on v1.splashz.xyz today and app.splashz.xyz or any
# other subdomain later — see docs/GO-LIVE-HANDOVER.md. Blank here: the host of
# NEXT_PUBLIC_APP_URL (localhost in development).
PASSKEY_RP_ID=
NEXT_PUBLIC_SUPPORT_EMAIL=support@splash.finance

# Email delivery (WS1). Verification links and password resets go through it, and a
# membership grant requires a verified mailbox. `console` prints the link to the server
# log and is refused in production; set `resend` with its API key and a sender address.
EMAIL_TRANSPORT=console
EMAIL_API_KEY=
EMAIL_FROM=
# Extra public origins allowed for state-changing requests when the app runs
# behind a reverse proxy, comma-separated (e.g. https://v1.splashz.xyz).
# The forwarded host is trusted automatically; use this for extra domains.
ALLOWED_ORIGINS=
# Proxies in front of the app: the client address for rate limits is read
# this many places from the end of X-Forwarded-For. Blank = 1 (nginx on the
# Droplet). Add one for each proxy in front of nginx, such as a CDN.
TRUSTED_PROXY_HOPS=
# App Platform only: do-connecting-ip. Its X-Forwarded-For holds DigitalOcean's
# ingress address, so without this every visitor shares one rate-limit bucket.
# Leave blank on the Droplet: nginx would pass a caller's own header through.
CLIENT_IP_HEADER=

# Optional — enables Claude generation for Zeke. Without it Zeke still answers
# from grounded, scripted domain responses.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Scheduler-only secret for the cron routes. Fail-closed.
CRON_SECRET=

# Dual funding. Runtime options are served by /api/funding/options and are
# revalidated server-side when sessions and deposits are accepted.
FEATURE_DUAL_FUNDING=true
FUNDING_PROVIDER_STRIPE_ENABLED=true
FUNDING_PROVIDER_AIRWALLEX_ENABLED=true
FUNDING_ASSET_USDC_ENABLED=true
# Native USDC sent on Solana straight to the org's vault.
FUNDING_RAIL_SOLANA_ENABLED=true
# Research-gated. Keep false until every gate in experiments/funding/RESEARCH.md passes.
FUNDING_RAIL_CCTP_ENABLED=true
# The three CCTP source chains are on here by choice. lib/env.ts declares them
# default false; lib/funding/registry.ts, which decides, treats blank as on.
# Set false to close a chain.
FUNDING_CCTP_ETHEREUM_ENABLED=true
FUNDING_CCTP_BASE_ENABLED=true
FUNDING_CCTP_ARBITRUM_ENABLED=true
# Off: a payout funded from held USDC is 0.70% like every other.
FUNDING_DISCOUNT_BPS=0
FUNDING_SELF_CUSTODY_STAGED_LIMIT_USD=10000
# CCTP deposit addresses on each source chain, per business account.
# Native USDC on Solana goes to the org's own vault; nothing is derived.
# JSON: {"<business-account-id>":{"ETHEREUM":"0x...","BASE":"0x...","ARBITRUM":"0x..."}}
FUNDING_CCTP_DEPOSIT_ADDRESSES_JSON=
# Shared secret required on POST /api/funding/deposits outside demo mode.
FUNDING_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
AIRWALLEX_API_KEY=

# Trust & compliance page gate: "true" removes the DRAFT watermark and noindex.
# Flip only after counsel signs off on the /trust copy.
LEGAL_APPROVED=

# On-chain proof panel (landing How-it-works): explorer links render only
# when set. Fill with real devnet transaction signatures after a verified run.
PROOF_TX_1=
PROOF_TX_2=

# ── Onboarding ─────────────────────────────────────────────────────────────
# Google sign-in (OIDC code + PKCE, lib/auth/google-oidc.ts). Off by default;
# when on, production needs all three GOOGLE_OIDC_* values.
FEATURE_GOOGLE_SIGNIN=false
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=
# KYB money gate (§3.2). Default OFF: enabling it before orgs have a real
# lifecycle row would put the demo workspace into read-only.
FEATURE_KYB_GATE=false
# Killed-entity domains (§2.4), comma-separated. ccacc.io is always denied.
KILLED_ENTITY_DOMAINS=

# ── Evidence (lib/evidence-sui/): Seal encryption + Walrus storage ─────
# The only part of this build that uses Sui. Testnet unless set.
EVIDENCE_SUI_NETWORK=testnet
EVIDENCE_SUI_RPC_URL=
# Gas for allowlist updates only; devnet/testnet. Production uses a KMS.
EVIDENCE_SPONSOR_SUI_PRIVATE_KEY=
WALRUS_EPOCHS=53
